# GEMINI_API_KEY: Required for Gemini AI API calls, text generation, translation, and TTS.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base public URL of the deployed application (e.g., https://your-app.run.app)
APP_URL="https://your-app.run.app"

# PORT: Optional port for server (defaults to 3000)
PORT="3000"

# NODE_ENV: Environment mode ('production' or 'development')
NODE_ENV="production"
